{
  "name": "@pocket-desk/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/bootstrap.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "build": "tsc -p tsconfig.json && vite build && node -e \"require('fs').cp('src/preload.cjs','dist/preload.cjs',e=>{if(e)throw e;console.log('preload.cjs copied')})\"",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:renderer": "tsc --noEmit -p src/renderer/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@pocket-desk/protocol": "*",
    "express": "^4.21.0",
    "qrcode": "^1.5.4",
    "systeminformation": "^5.33.23",
    "tsconfig-paths": "^4.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.12",
    "electron": "^33.0.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
