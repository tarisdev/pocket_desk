{
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@utils/*": ["./utils/*"],
      "@screens/*": ["./screens/*"],
      "@state/*": ["./state/*"],
      "@i18n/*": ["./i18n/*"],
      "@renderer/*": ["./*"]
    }
  },
  "include": ["app.ts"]
}
